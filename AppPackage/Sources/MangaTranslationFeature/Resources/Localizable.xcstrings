  "languages_footer": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Sprachmetadaten der Galerie haben Vorrang. Die Standard-Quellsprache gilt nur, wenn keine Metadaten vorhanden sind."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Gallery language metadata is used first. The default source language applies only when metadata is missing."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ギャラリーの言語メタデータが優先されます。デフォルトの原文言語はメタデータがない場合にのみ適用されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "갤러리 언어 메타데이터가 우선 적용됩니다. 기본 원문 언어는 메타데이터가 없을 때만 적용됩니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "优先使用画廊的语言元数据。仅当元数据缺失时才使用默认原文语言。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "優先使用畫廊的語言中繼資料。僅當中繼資料缺失時才使用預設原文語言。"
     }
    }
   }
  },
