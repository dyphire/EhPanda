  "api_section_footer": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gib die API-Basis-URL ein, einschließlich /v1 falls erforderlich (z. B. https://api.openai.com/v1). Die Endpunkte /models und /chat/completions werden unter dieser URL aufgerufen. Basis-URL, API-Schlüssel und Modell sind erforderlich."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Enter the API root, including /v1 when required (for example, https://api.openai.com/v1). The /models and /chat/completions endpoints are called under this URL. Base URL, API Key, and Model are required."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "必要に応じて /v1 を含む API のルート URL を入力してください（例：https://api.openai.com/v1）。この URL の下で /models と /chat/completions が呼び出されます。ベース URL、API キー、モデルは必須です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "필요한 경우 /v1을 포함한 API 루트를 입력하세요(예: https://api.openai.com/v1). 이 URL 아래에서 /models 및 /chat/completions 엔드포인트가 호출됩니다. 기본 URL, API 키, 모델은 필수입니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "输入 API 根地址，需要时包含 /v1（例如 https://api.openai.com/v1）。/models 和 /chat/completions 端点会在该地址下被调用。Base URL、API Key 和模型为必填项。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "輸入 API 根位址，需要時包含 /v1（例如 https://api.openai.com/v1）。/models 和 /chat/completions 端點會在該位址下被呼叫。Base URL、API Key 和模型為必填項。"
     }
    }
   }
  },
