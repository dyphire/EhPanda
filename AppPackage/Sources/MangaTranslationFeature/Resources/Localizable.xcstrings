  "privacy_provider_metadata": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR-Text und Galerie-Metadaten werden an den Anbieter gesendet; Seitenbilder werden niemals hochgeladen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR text and gallery metadata are sent to the provider; page images are never uploaded."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR テキストとギャラリーのメタデータはプロバイダーに送信されます。ページ画像がアップロードされることはありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR 텍스트와 갤러리 메타데이터는 제공업체로 전송되며, 페이지 이미지는 절대 업로드되지 않습니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR 文本和画廊元数据会发送给服务提供商；页面图像绝不会被上传。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR 文字和畫廊中繼資料會傳送給服務提供商；頁面圖像絕不會上傳。"
     }
    }
   }
  },
  "privacy_provider_text_only": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nur OCR-Text wird an den Anbieter gesendet; Seitenbilder werden niemals hochgeladen."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Only OCR text is sent to the provider; page images are never uploaded."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR テキストのみがプロバイダーに送信されます。ページ画像がアップロードされることはありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "OCR 텍스트만 제공업체로 전송되며, 페이지 이미지는 절대 업로드되지 않습니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "仅 OCR 文本会发送给服务提供商；页面图像绝不会被上传。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "僅 OCR 文字會傳送給服務提供商；頁面圖像絕不會上傳。"
     }
    }
   }
  },
  "privacy_system": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Erkennung und Übersetzung laufen auf dem Gerät. Seitenbilder verlassen das Gerät niemals."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Recognition and translation run on device. Page images never leave the device."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "認識と翻訳はデバイス上で実行されます。ページ画像がデバイスから送信されることはありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "인식과 번역이 기기에서 실행됩니다. 페이지 이미지는 기기를 벗어나지 않습니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "识别与翻译均在设备上运行。页面图像绝不会离开设备。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "辨識與翻譯均在裝置上執行。頁面圖像絕不會離開裝置。"
     }
    }
   }
  },
  "privacy_unconfigured": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Konfiguriere einen LLM-Anbieter, um die Übersetzung zu aktivieren. Seitenbilder verlassen das Gerät niemals."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Configure an LLM provider to enable translation. Page images never leave the device."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "翻訳を有効にするには LLM プロバイダーを設定してください。ページ画像がデバイスから送信されることはありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "번역을 사용하려면 LLM 제공업체를 설정하세요. 페이지 이미지는 기기를 벗어나지 않습니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "配置 LLM 服务以启用翻译。页面图像绝不会离开设备。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "設定 LLM 服務以啟用翻譯。頁面圖像絕不會離開裝置。"
     }
    }
   }
  },
  "providers_footer": {
   "extractionState": "manual",
   "localizations": {
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "LLM-Anbieter erhalten nur OCR-Text und optionale Galerie-Metadaten. Systemübersetzung und Seitenbilder bleiben auf dem Gerät."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "LLM providers receive only OCR text and optional gallery metadata. System Translation and page images stay on device."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "LLM プロバイダーに送信されるのは OCR テキストと任意のギャラリーメタデータのみです。システム翻訳とページ画像はデバイス内にとどまります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "LLM 제공업체는 OCR 텍스트와 선택적 갤러리 메타데이터만 받습니다. 시스템 번역과 페이지 이미지는 기기에 남습니다."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "LLM 服务仅接收 OCR 文本和可选的画廊元数据。系统翻译与页面图像都留在设备上。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "LLM 服務僅接收 OCR 文字和可選的畫廊中繼資料。系統翻譯與頁面圖像都留在裝置上。"
     }
    }
   }
  },
